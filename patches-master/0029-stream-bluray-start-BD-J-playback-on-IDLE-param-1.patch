From 1e6515e209f37d101295a553ff246d2de1de092c Mon Sep 17 00:00:00 2001
From: Yiqiang Zheng <kenken7429@users.noreply.github.com>
Date: Sat, 29 Aug 2026 10:38:00 +0800
Subject: [PATCH] feat(stream/bluray): start BD-J playback on IDLE(1) via
 bd_select_rate

---
 stream/stream_bluray.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/stream/stream_bluray.c b/stream/stream_bluray.c
index 04b2520..9a97ec5 100644
--- a/stream/stream_bluray.c
+++ b/stream/stream_bluray.c
@@ -552,6 +552,12 @@ static int bluray_stream_fill_buffer(stream_t *s, void *buf, int len)
             break;
         case BD_EVENT_IDLE:
             bdj_idle = true;
+            // BD-J prefetched a playlist (bdj_wait_start=1): bd_read_ext()
+            // returns IDLE(1)+0 bytes until bd_select_rate() starts it.
+            // Without this, the demuxer sees EOF after a menu item is
+            // clicked and mpv exits.
+            if (ev.param == 1)
+                bd_select_rate(b->bd, 1.0f, BDJ_PLAYBACK_START);
             break;
         case BD_EVENT_STILL:
             mp_mutex_lock(&b->overlay_lock);
-- 
