From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mathieu GRENET <mathieu@mgth.fr>
Date: Mon, 25 May 2026 21:07:49 +0200
Subject: [PATCH 6/6] audio: route E-AC3 (JOC) Atmos through ad_orender

ad_orender only accepted truehd, and the decoder-selection gate in
f_decoder_wrapper.c only switched to ad_orender for truehd, so E-AC3
Atmos fell back to ad_lavc (lossy core, no objects).

- create()/add_decoders(): accept "eac3" and pass codec->codec to
  liborender so the bridge routes its raw transport correctly.
- f_decoder_wrapper: extend the --ad=orender opt-in gate to eac3.

Co-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>
---
 audio/decode/ad_orender.c   | 15 ++++++++++++---
 filters/f_decoder_wrapper.c | 12 +++++++-----
 2 files changed, 19 insertions(+), 8 deletions(-)

diff --git a/audio/decode/ad_orender.c b/audio/decode/ad_orender.c
index 2e2bcf4..748c6ff 100644
--- a/audio/decode/ad_orender.c
+++ b/audio/decode/ad_orender.c
@@ -214,7 +214,8 @@ static void ad_orender_process(struct mp_filter *da)
         p->checked_spatial = true;
         if (orender_is_spatial(p->renderer) != 1) {
             MP_WARN(da, "no Atmos objects detected; rendering the bed only "
-                        "(use plain TrueHD without --ad=orender)\n");
+                        "(decode this track without --ad=orender for the "
+                        "standard downmix)\n");
         }
         if (!build_chmap(p))
             MP_WARN(da, "output layout has speakers with no mpv mapping\n");
@@ -274,8 +275,10 @@ static struct mp_decoder *create(struct mp_filter *parent,
                                  struct mp_codec_params *codec,
                                  const char *decoder)
 {
-    if (!codec->codec || strcmp(codec->codec, "truehd") != 0)
+    if (!codec->codec ||
+        (strcmp(codec->codec, "truehd") != 0 && strcmp(codec->codec, "eac3") != 0))
         return NULL;
+    bool is_eac3 = strcmp(codec->codec, "eac3") == 0;
 
     struct mp_filter *da = mp_filter_create(parent, &ad_orender_filter);
     if (!da)
@@ -304,6 +307,9 @@ static struct mp_decoder *create(struct mp_filter *parent,
         .config_yaml_path    = nz(opts->config_path),
         .speaker_layout_path = NULL,
         .bridge_path         = nz(opts->bridge_path),
+        /* Tell the bridge which codec the raw access units carry: its raw
+         * transport has no data-type byte to tell TrueHD from E-AC3 apart. */
+        .codec               = codec->codec,
         .osc_enabled         = opts->osc ? 1 : 0,
         .osc_port_in         = (uint16_t)opts->osc_rx_port,
         .osc_port_out        = (uint16_t)opts->osc_port,
@@ -321,7 +327,8 @@ static struct mp_decoder *create(struct mp_filter *parent,
     }
 
     p->channels = orender_channel_count(p->renderer);
-    codec->codec_desc = "TrueHD/Atmos (orender)";
+    codec->codec_desc = is_eac3 ? "E-AC3/Atmos (orender)"
+                                : "TrueHD/Atmos (orender)";
 
     return &p->public;
 }
@@ -330,6 +337,8 @@ static void add_decoders(struct mp_decoder_list *list)
 {
     mp_add_decoder(list, "truehd", "orender",
                    "TrueHD/Atmos via liborender (VBAP object rendering)");
+    mp_add_decoder(list, "eac3", "orender",
+                   "E-AC3/Atmos (JOC) via liborender (VBAP object rendering)");
 }
 
 const struct mp_decoder_fns ad_orender = {
diff --git a/filters/f_decoder_wrapper.c b/filters/f_decoder_wrapper.c
index 9073f4c..54376bf 100644
--- a/filters/f_decoder_wrapper.c
+++ b/filters/f_decoder_wrapper.c
@@ -455,12 +455,14 @@ static bool reinit_decoder(struct priv *p)
         }
 
 #if HAVE_ORENDER
-        // Opt-in Atmos object rendering for TrueHD via `--ad=orender`. Unlike
-        // ad_spdif this outputs normal float PCM (AF_FORMAT_FLOAT), so the
-        // native resampler / audio filter chain still applies. Gated on the
-        // explicit decoder name so default TrueHD playback is unaffected.
+        // Opt-in Atmos object rendering for TrueHD / E-AC3 (JOC) via
+        // `--ad=orender`. Unlike ad_spdif this outputs normal float PCM
+        // (AF_FORMAT_FLOAT), so the native resampler / audio filter chain still
+        // applies. Gated on the explicit decoder name so default playback is
+        // unaffected.
         if (driver == &ad_lavc && p->codec->codec &&
-            strcmp(p->codec->codec, "truehd") == 0 &&
+            (strcmp(p->codec->codec, "truehd") == 0 ||
+             strcmp(p->codec->codec, "eac3") == 0) &&
             decoder_list_has(user_list, "orender"))
         {
             struct mp_decoder_list *ol =
