# FEL dependency sources — sourced by scripts/build-fel-deps.sh.
#
# Policy: FOLLOW the dv-fel branch HEAD. kasper93 force-pushes dv-fel almost
# daily, so a pinned SHA orphans fast; build-fel-deps.sh fetches and hard-resets
# to origin/dv-fel on every run. The ffmpeg dovi_split patch is vendored
# (deps-fel/ffmpeg/*.patch).

# libplacebo dv-fel — reconstructs the FEL (pl_frame.enhancement_layer); needs
# PL_API_VER >= 367 (>= 7.370 by modversion). No released libplacebo has it.
LIBPLACEBO_URL="https://code.videolan.org/kasper93/libplacebo.git"
LIBPLACEBO_REF="dv-fel"

# ffmpeg base + vendored dovi_split BSF patch (deps-fel/ffmpeg/*.patch).
# release/8.1 = stable ABI (libavcodec.62); master also works.
FFMPEG_URL="https://git.ffmpeg.org/ffmpeg.git"
FFMPEG_REF="release/8.1"

# Upstream tracking — the day all three merge AND ship in releases, drop
# patches-fel/, deps-fel/ and build-fel.yml and link the system libs:
#   mpv        : https://github.com/mpv-player/mpv/pull/17932
#   libplacebo : https://code.videolan.org/videolan/libplacebo/-/merge_requests/851
#   ffmpeg     : https://patchwork.ffmpeg.org  (PR #23122, BSF dovi_split)
